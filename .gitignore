# entorno virtual
.venv/

# datos de mercado (nunca se versionan; se conserva la carpeta vacia)
datos/*
!datos/.gitkeep

# salidas de experimentos (se regeneran corriendo el codigo)
resultados/*
!resultados/.gitkeep

# python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# PDF: ningun paper se sube por error (derechos de autor y peso). La unica
# excepcion es el PDF del pre-registro, que vive en registro/ y si se versiona.
*.pdf
!registro/*.pdf
